# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# JWT Secret for Authentication (MUST be at least 32 characters for security!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# MongoDB Connection String (Required for Render.com deployment)
# Get free MongoDB Atlas cluster at: https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/music-archive?retryWrites=true&w=majority

# Admin Panel Credentials (CHANGE THESE IN PRODUCTION!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# Port (Render assigns automatically, local default is 3000)
PORT=3000
