# ==========================================
# 🔐 MUSIC LIBRARY - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Spotify API Credentials
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ==========================================
# 🔒 SECURITY - MUST CHANGE FOR PRODUCTION!
# ==========================================

# JWT Secret for Authentication
# MUST be at least 32 random characters for security!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING_xYz123AbC456

# Admin Panel Credentials
# ⚠️ CHANGE THESE IMMEDIATELY FOR PRODUCTION!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD_123!

# ==========================================
# 📦 DATABASE
# ==========================================

# MongoDB Connection String
# Get free MongoDB Atlas cluster at: https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/music-archive?retryWrites=true&w=majority

# ==========================================
# 🌐 SERVER
# ==========================================

# Port (Render assigns automatically, local default is 3000)
PORT=3000
