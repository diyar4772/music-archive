{
    "name": "music-archive",
    "version": "2.0.0",
    "description": "Music Archive — personal music collection with Spotify search, ratings and notes",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "audit": "node scripts/audit.mjs",
        "migrate:notes": "node scripts/migrate-notes.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --test test/*.test.js",
        "test:browser": "node test/browser/studio-smoke.mjs",
        "test:journal": "node test/browser/journal.mjs",
        "test:admin": "node test/browser/admin-panel.mjs",
        "check": "npm run lint && npm test"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.0.3"
    },
    "devDependencies": {
        "eslint": "^9.39.5",
        "globals": "^17.12.0"
    }
}
